// /sedum:setType
// sedum:setVar {"v":2,"tier":"owned","record":"prov-2026-125fbdc2","gen":"sha256:d85a57328c34216d037ca58c1f786294f81d9bb7c715099ae9f4ae095d0ce976","pkg":"sha256:c7b9d9ac1655e8211b8b2ca8c49cf34b8d510d8d823d4f5eb60ec7e1018aa2eb","id":{"file":"running.go","name":"handlers"},"kwargs":"sha256:911d20433ae70a2c142c42710b52fc1d85acc0f44a34d261149d4352678ec091","body":"sha256:e03ad83aab31896f46a889e36d43e34a0bf331b1f4d309adb0db2cefc22e411b"}
var handlers = map[string]func(s *Server, c *Client, m Message){}

// /sedum:setVar
// sedum:setFunction {"v":2,"tier":"owned","record":"prov-2026-125fbdc2","gen":"sha256:d85a57328c34216d037ca58c1f786294f81d9bb7c715099ae9f4ae095d0ce976","pkg":"sha256:6589611adfb6618a7920e43f951a79901428192ea95c1084fde9f222aecd9537","id":{"file":"running.go","name":"main"},"kwargs":"sha256:776cb5faad781a3caea0d2e9e4a6f73bb55379a2e441fae810eecfbafff18f84","body":"sha256:eefb8e774f1f5cefa625e10639eb4f58ec60b225fe4d44ccefb03644bc979fca"}
func main() {
	addr := flag.String("addr", ":6667", "listen address")
	flag.Parse()
	s := &Server{clients: map[string]*Client{}, channels: map[string]*channel{}}
	ln, err := net.Listen("tcp", *addr)
	if err != nil {
		log.Fatal(err)
	}
	for {
		conn, err := ln.Accept()
		if err != nil {
			log.Fatal(err)
		}
		go s.serve(conn)
	}
}

// /sedum:setFunction
// sedum:setMethod {"v":2,"tier":"owned","record":"prov-2026-125fbdc2","gen":"sha256:d85a57328c34216d037ca58c1f786294f81d9bb7c715099ae9f4ae095d0ce976","pkg":"sha256:8ea07fc52bbc260836983438ef08ad02746b86a1028c8b1a51b60eeb7b83cc2b","id":{"file":"running.go","name":"serve","receiver":"Server"},"kwargs":"sha256:caab637ca704650df30e84544b1cf9d0c6d993a26d430def95de0a4092652b42","body":"sha256:41c06f8367de35516319975b5950086bb694ee38c2c3db2118a3d3692ab740dd"}
// serve runs one connection: it sets c.conn, reads CRLF or bare-LF lines, dispatches through handlers, and calls Disconnect when the connection ends.
// serve is rendered by graft; its body is a convergence region (runningServeBody).
func (s *Server) serve(conn net.Conn) {
	s.runningServeBody(conn)
}

// /sedum:setMethod
// sedum:setMethod {"v":2,"tier":"owned","record":"prov-2026-125fbdc2","gen":"sha256:d85a57328c34216d037ca58c1f786294f81d9bb7c715099ae9f4ae095d0ce976","pkg":"sha256:8ea07fc52bbc260836983438ef08ad02746b86a1028c8b1a51b60eeb7b83cc2b","id":{"file":"running.go","name":"Send","receiver":"Client"},"kwargs":"sha256:b8f3b1ac2741dff1d44493aa55dcacd4e14718816212525b45ebfcc3c35e137b","body":"sha256:569136256b3fe851c221961b424a5b7e9d4613b45cc80fccdd76817ceea7b7b5"}
// Send queues one protocol line for c. line carries no trailing CRLF and is already complete, including any leading ':'; Send only appends CRLF.
// Send is rendered by graft; its body is a convergence region (runningSendBody).
func (c *Client) Send(line string) {
	c.runningSendBody(line)
}

// /sedum:setMethod
// sedum:setMethod {"v":2,"tier":"owned","record":"prov-2026-125fbdc2","gen":"sha256:d85a57328c34216d037ca58c1f786294f81d9bb7c715099ae9f4ae095d0ce976","pkg":"sha256:8ea07fc52bbc260836983438ef08ad02746b86a1028c8b1a51b60eeb7b83cc2b","id":{"file":"running.go","name":"Reply","receiver":"Server"},"kwargs":"sha256:ddfe5a2c736d909762c0ed09ed1c9b7876068440325bad6c34acce229db98307","body":"sha256:b53ecc8fa38b42252290c7734a699601724e1eb9612ce65c929233ce20e10a7f"}
// Reply sends c a line from the server itself, built in full: ":" + serverName + " " + code + " " + target + " :" + text, where target is c.Nick, or "*" before c has a nick.
// Reply is rendered by graft; its body is a convergence region (runningReplyBody).
func (s *Server) Reply(c *Client, code string, text string) {
	s.runningReplyBody(c, code, text)
}

// /sedum:setMethod
// sedum:setMethod {"v":2,"tier":"owned","record":"prov-2026-125fbdc2","gen":"sha256:d85a57328c34216d037ca58c1f786294f81d9bb7c715099ae9f4ae095d0ce976","pkg":"sha256:8ea07fc52bbc260836983438ef08ad02746b86a1028c8b1a51b60eeb7b83cc2b","id":{"file":"running.go","name":"Prefix","receiver":"Client"},"kwargs":"sha256:65751d85f65314163e9ce0e6747601f13cd397ca721f136021ebcb4758f9f3b6","body":"sha256:99fe631abd4406f4f94d4d241ab0c1c1008ea40909e0b4be05c2a8923d68c320"}
// Prefix returns c's prefix, nick!user@freeq-lite, WITHOUT the leading ':'. Every sender of a prefixed line adds the ':' itself (":" + c.Prefix() + " JOIN ..."), including QUIT.
// Prefix is rendered by graft; its body is a convergence region (runningPrefixBody).
func (c *Client) Prefix() string {
	return c.runningPrefixBody()
}

// /sedum:setMethod
// sedum:setMethod {"v":2,"tier":"owned","record":"prov-2026-125fbdc2","gen":"sha256:d85a57328c34216d037ca58c1f786294f81d9bb7c715099ae9f4ae095d0ce976","pkg":"sha256:8ea07fc52bbc260836983438ef08ad02746b86a1028c8b1a51b60eeb7b83cc2b","id":{"file":"running.go","name":"Disconnect","receiver":"Server"},"kwargs":"sha256:c4be08db210935756365f9ba8abf845da5ea43047b3a0faac254925006cc8eee","body":"sha256:04788e13c6f81884b6bc41720a00adb340d41877eedc04865ec0ea47d6bb6bc9"}
// Disconnect removes c from the server and from every channel, tells the channel peers ":" + c.Prefix() + " QUIT :" + reason (once each), then closes c.conn.
// Disconnect is rendered by graft; its body is a convergence region (runningDisconnectBody).
func (s *Server) Disconnect(c *Client, reason string) {
	s.runningDisconnectBody(c, reason)
}

