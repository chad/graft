{
  "module": "ledgerlite",
  "tier": "low",
  "attempts": 3,
  "conventions": "conventions.md",
  "model": {
    "argv": ["claude", "-p", "--tools", "", "--strict-mcp-config", "--model", "sonnet"],
    "timeout_sec": 600
  },
  "policy": { "low": ["static_analysis", "eval"] },
  "gates": [
    { "label": "go build", "argv": ["go", "build", "./..."], "kind": "static_analysis", "timeout_sec": 300 },
    { "label": "go vet", "argv": ["go", "vet", "./..."], "kind": "static_analysis", "timeout_sec": 300 },
    { "label": "no dead functions", "argv": ["go", "run", "../freeq-lite/gates/unused/unused.go"], "kind": "static_analysis", "timeout_sec": 300 },
    { "label": "smoke (visible)", "argv": ["go", "run", "./smoke/smoke.go"], "kind": "eval", "timeout_sec": 300 }
  ],
  "visible": ["smoke/smoke.go"]
}
